# Base URL for the Django API. In production, set this to your Render backend URL.
# Example: VITE_API_BASE_URL=https://trustshield-backend.onrender.com/api
VITE_API_BASE_URL=https://trustshield-backend.onrender.com/api
# true = use the in-browser mock API instead of Django (UI-only development).
# MUST be false in production so the frontend calls the real backend and real ML models.
VITE_USE_MOCK=false
# Where the Vite dev server forwards /api requests (local development only)
VITE_API_PROXY_TARGET=http://127.0.0.1:8254
