# Copy to .env and adjust. Never commit the real .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,*.onrender.com
# Comma-separated origins allowed to call the API (the React app)
CORS_ALLOWED_ORIGINS=https://trustshield-frontend.onrender.com
CORS_ALLOWED_ORIGIN_REGEXES=https://.*\.onrender\.com
# Leave unset to use SQLite; on Render, set DATABASE_URL from the managed PostgreSQL
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Load ML models when the server starts instead of on the first request
ML_PRELOAD=true
ML_ENABLED=true

# Key for fingerprinting phone numbers and domains in community memory (defaults to the secret key)
INDICATOR_HASH_KEY=

# Email: console output in development. Configure SMTP for real delivery.
FRONTEND_URL=https://trustshield-frontend.onrender.com
# EMAIL_HOST=smtp.example.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=TrustShield 254 <no-reply@example.com>

# Optional LLM explainer (any OpenAI-compatible endpoint, e.g. Ollama or vLLM serving Qwen/Llama).
# Leave LLM_API_BASE empty to use the built-in template explanation.
LLM_API_BASE=
LLM_MODEL=qwen2.5:7b-instruct
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=8
